# =====================================================================
# AgriPilot - Cellular SMS Gateway Configuration for Genuine OTP
# =====================================================================
# To receive OTPs directly on your physical mobile handset SIM:
#
# Option A: Fast2SMS (Recommended for Indian +91 numbers - 50 free SMS)
# 1. Sign up at https://www.fast2sms.com
# 2. Copy your API Key from Dev API tab
# 3. Paste it below:
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option B: Twilio (International & Indian SMS)
# 1. Sign up at https://www.twilio.com
# 2. Copy Account SID & Auth Token from Console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
